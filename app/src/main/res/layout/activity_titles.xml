<?xml version="1.0" encoding="utf-8"?>
<!-- 作品を選ぶ画面。テレビの外周5%には置かない(Fire TV のデザイン指針) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14161A"
    android:orientation="vertical"
    android:paddingHorizontal="96dp"
    android:paddingVertical="54dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FF8A3D"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/titles_heading"
        android:textColor="#F3F1EC"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/titles_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/titles_loading"
        android:textColor="#9AA3B2"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/titles_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical" />
</LinearLayout>
