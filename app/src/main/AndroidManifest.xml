<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- テレビ向け。タッチ画面とリーンバックは必須にしない(Fire TV の要件) -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Fire TV で Alexa の再生操作("Alexa, pause" など)を MediaSession で受け取るための権限
         (Amazon 文書 mediasession-api-integration、2026-06-05 更新) -->
    <uses-permission android:name="com.amazon.permission.media.session.voicecommandcontrol" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name"
        android:theme="@style/Theme.AskAlong">
        <activity
            android:name=".TitlesActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
    </application>
</manifest>
